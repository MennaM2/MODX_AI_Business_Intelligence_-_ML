# Copy this file to .env and fill in the values you need.
# Everything below has a sensible default (see app/config.py) except
# SMTP, which is optional and only needed for email report delivery.


# Used when LLM_PROVIDER=gemini.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=75
GEMINI_MAX_RETRIES=2

# --- Storage ---
UPLOAD_DIR=data/uploads
PREPARED_DIR=data/prepared
OUTPUT_DIR=outputs

# Data Preparation Engine: off by default. When enabled, ambiguous
# cross-dataset column matches (metadata only - names, types, and a
# few sample values, never full datasets) are sent to Gemini as a
# tie-breaker. Deterministic matching runs either way.
DATA_ENGINE_LLM_MATCHING=false
SESSIONS_DB_PATH=data/sessions.db

# --- Conversation memory ---
# How many recent turns to keep per session (keep this small - the
# model's context window is limited).
MAX_HISTORY_MESSAGES=8

# --- API ---
# Used by the Streamlit UI to reach the FastAPI backend.
API_BASE_URL=http://localhost:8000

# --- Automation: email report delivery (optional) ---
# Leave these blank to disable email delivery - the agent will still
# generate and save reports, and will clearly say email wasn't sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true